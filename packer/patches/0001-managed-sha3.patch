--- /dev/null
+++ b/src/LibProsperoPkg/Util/ManagedSha3.cs
@@ -0,0 +1,160 @@
+// LibProsperoPkg - A library for building and inspecting PS5 packages.
+// Copyright (C) 2026 SvenGDK
+//
+// Managed SHA3-256 (FIPS 202). .NET delegates SHA-3 to the OS and macOS has no
+// implementation at all, so every package build there used to fail before the
+// first block. This is a straight Keccak-f[1600] sponge with a 136-byte rate.
+#nullable disable
+using System;
+using System.IO;
+
+namespace LibProsperoPkg.Util;
+
+public sealed class ManagedSha3
+{
+    private const int Rate = 136; // 1088-bit rate for a 256-bit digest
+    private static readonly ulong[] RoundConstants =
+    {
+        0x0000000000000001UL, 0x0000000000008082UL, 0x800000000000808aUL, 0x8000000080008000UL,
+        0x000000000000808bUL, 0x0000000080000001UL, 0x8000000080008081UL, 0x8000000000008009UL,
+        0x000000000000008aUL, 0x0000000000000088UL, 0x0000000080008009UL, 0x000000008000000aUL,
+        0x000000008000808bUL, 0x800000000000008bUL, 0x8000000000008089UL, 0x8000000000008003UL,
+        0x8000000000008002UL, 0x8000000000000080UL, 0x000000000000800aUL, 0x800000008000000aUL,
+        0x8000000080008081UL, 0x8000000000008080UL, 0x0000000080000001UL, 0x8000000080008008UL,
+    };
+
+    // Rotation offsets, indexed x + 5y.
+    private static readonly int[] Rotations =
+    {
+         0,  1, 62, 28, 27,
+        36, 44,  6, 55, 20,
+         3, 10, 43, 25, 39,
+        41, 45, 15, 21,  8,
+        18,  2, 61, 56, 14,
+    };
+
+    private readonly ulong[] state = new ulong[25];
+    private readonly byte[] block = new byte[Rate];
+    private int buffered;
+
+    public static byte[] Hash(byte[] data) => Hash(data.AsSpan());
+
+    public static byte[] Hash(ReadOnlySpan<byte> data)
+    {
+        var hasher = new ManagedSha3();
+        hasher.Append(data);
+        return hasher.Finish();
+    }
+
+    public static byte[] Hash(Stream data)
+    {
+        var hasher = new ManagedSha3();
+        var buffer = new byte[81920];
+        int read;
+        while ((read = data.Read(buffer, 0, buffer.Length)) > 0)
+            hasher.Append(buffer.AsSpan(0, read));
+        return hasher.Finish();
+    }
+
+    public static byte[] Hash(Stream data, long start, long length)
+    {
+        data.Position = start;
+        var hasher = new ManagedSha3();
+        var buffer = new byte[81920];
+        long left = length;
+        while (left > 0)
+        {
+            int want = (int)Math.Min(buffer.Length, left);
+            int read = data.Read(buffer, 0, want);
+            if (read <= 0) break;
+            hasher.Append(buffer.AsSpan(0, read));
+            left -= read;
+        }
+        return hasher.Finish();
+    }
+
+    public void Append(ReadOnlySpan<byte> data)
+    {
+        while (data.Length > 0)
+        {
+            int take = Math.Min(Rate - buffered, data.Length);
+            data.Slice(0, take).CopyTo(block.AsSpan(buffered));
+            buffered += take;
+            data = data.Slice(take);
+            if (buffered == Rate)
+            {
+                Absorb(block);
+                Permute();
+                // The next block starts empty; leaving the old bytes here made
+                // a short final block absorb stale data from the block before.
+                Array.Clear(block, 0, Rate);
+                buffered = 0;
+            }
+        }
+    }
+
+    public byte[] Finish()
+    {
+        block[buffered] ^= 0x06;
+        block[Rate - 1] ^= 0x80;
+        Absorb(block);
+        Permute();
+
+        var digest = new byte[32];
+        for (int i = 0; i < 4; i++)
+        {
+            ulong lane = state[i];
+            for (int b = 0; b < 8; b++)
+                digest[i * 8 + b] = (byte)(lane >> (8 * b));
+        }
+        return digest;
+    }
+
+    private void Absorb(byte[] source)
+    {
+        for (int i = 0; i < Rate; i++)
+            state[i / 8] ^= (ulong)source[i] << (8 * (i % 8));
+    }
+
+    private static ulong Rotl(ulong value, int shift) =>
+        shift == 0 ? value : (value << shift) | (value >> (64 - shift));
+
+    private void Permute()
+    {
+        var c = new ulong[5];
+        var b = new ulong[25];
+        for (int round = 0; round < 24; round++)
+        {
+            for (int x = 0; x < 5; x++)
+                c[x] = state[x] ^ state[x + 5] ^ state[x + 10] ^ state[x + 15] ^ state[x + 20];
+
+            for (int x = 0; x < 5; x++)
+            {
+                ulong d = c[(x + 4) % 5] ^ Rotl(c[(x + 1) % 5], 1);
+                for (int y = 0; y < 5; y++)
+                    state[x + 5 * y] ^= d;
+            }
+
+            for (int x = 0; x < 5; x++)
+            {
+                for (int y = 0; y < 5; y++)
+                {
+                    int source = x + 5 * y;
+                    int target = y + 5 * ((2 * x + 3 * y) % 5);
+                    b[target] = Rotl(state[source], Rotations[source]);
+                }
+            }
+
+            for (int x = 0; x < 5; x++)
+            {
+                for (int y = 0; y < 5; y++)
+                {
+                    int index = x + 5 * y;
+                    state[index] = b[index] ^ ((~b[(x + 1) % 5 + 5 * y]) & b[(x + 2) % 5 + 5 * y]);
+                }
+            }
+
+            state[0] ^= RoundConstants[round];
+        }
+    }
+}
